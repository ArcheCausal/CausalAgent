
# 非密钥环境变量模板。
# 密码、令牌和签名密钥不在本文件：它们统一保存在密钥文件里（本地为仓库根目录的
# causalagent.env，容器内为 /run/secrets/causalagent.env）。键集合与模板见
# deploy/secrets/causalagent.env.example；应用启动时缺少密钥文件会直接失败。

# API 基础URL（OpenAI官方或第三方兼容接口）
BASE_URL=
MODEL=

# Deep Agent 专用 Responses API 配置；密钥只通过密钥文件注入。
DEEP_AGENT_MODEL=deepseek-v4-flash
DEEP_AGENT_BASE_URL=
DEEP_AGENT_CONTEXT_WINDOW_TOKENS=1000000

# Sandbox controller; all secrets are read from the shared causalagent.env.
CAUSALAGENT_SANDBOX_CONTROLLER_URL=http://sandbox-controller:8081
CAUSALAGENT_SANDBOX_CONTROLLER_TIMEOUT_SECONDS=330
CAUSALAGENT_OPENSANDBOX_CONFIG_SOURCE=./deploy/opensandbox/config.toml
# Required: build deploy/opensandbox/Dockerfile and supply its published digest.
# The controller refuses startup while the required image is empty.
CAUSALAGENT_SANDBOX_IMAGE=
# Controller policy; per-worker concurrency/wait settings still belong to Worker.
CAUSALAGENT_SANDBOX_GLOBAL_CAPACITY=4
CAUSALAGENT_SANDBOX_HEARTBEAT_TIMEOUT_SECONDS=90
CAUSALAGENT_SANDBOX_RECONCILE_INTERVAL_SECONDS=15
CAUSALAGENT_SANDBOX_CPU_LIMIT=1
CAUSALAGENT_SANDBOX_MEMORY_LIMIT=2Gi
CAUSALAGENT_SANDBOX_TTL_SECONDS=900
CAUSALAGENT_SANDBOX_COMMAND_TIMEOUT_SECONDS=300
CAUSALAGENT_SANDBOX_API_TIMEOUT_SECONDS=30
CAUSALAGENT_SANDBOX_MAX_CONCURRENT_PER_WORKER=2
CAUSALAGENT_SANDBOX_GLOBAL_CAPACITY_WAIT_SECONDS=300
CAUSALAGENT_SANDBOX_MAX_INPUT_BYTES=67108864
CAUSALAGENT_SANDBOX_MAX_PREVIEW_BYTES=32768
CAUSALAGENT_SANDBOX_MAX_OUTPUT_FILE_BYTES=67108864
CAUSALAGENT_SANDBOX_MAX_COMMAND_BYTES=16384
CAUSALAGENT_SANDBOX_MAX_COMMAND_OUTPUT_BYTES=65536
CAUSALAGENT_SANDBOX_AGENT_UID=10001
CAUSALAGENT_SANDBOX_AGENT_GID=10001

# 新 worker 使用的 causal-mcp Streamable HTTP 客户端池配置。
CAUSAL_MCP_URL=http://causal-mcp:8080/mcp
CAUSAL_MCP_SIGNING_KEY_ID=current
CAUSAL_MCP_CLIENT_POOL_SIZE=2
CAUSAL_MCP_MAX_IN_FLIGHT_PER_CLIENT=1
CAUSAL_MCP_POOL_ACQUIRE_TIMEOUT_SECONDS=5
CAUSAL_MCP_CONTROL_POOL_SIZE=1
CAUSAL_MCP_CONTROL_MAX_IN_FLIGHT_PER_CLIENT=2
CAUSAL_MCP_CONTROL_ACQUIRE_TIMEOUT_SECONDS=1
CAUSAL_MCP_CANCEL_TIMEOUT_SECONDS=6
CAUSAL_MCP_HTTP_MAX_CONNECTIONS=8
CAUSAL_MCP_HTTP_MAX_KEEPALIVE_CONNECTIONS=4
CAUSAL_MCP_HTTP_READ_TIMEOUT_SECONDS=660
CAUSAL_MCP_SLOW_LOG_SECONDS=60
CDFM_MODEL_PATH=/opt/cdfm-weights-image

# 正式多模态 embedding：只保存地址与模型名，实际密钥只进入密钥文件。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
# Docker环境：使用服务名 'mysql'
# 本地开发：使用 'localhost' 或 '127.0.0.1'
MYSQL_HOST=mysql

# 兼容账号。未配置拆分账号时，写/读连接会回退使用它。
MYSQL_USER=pyramid


# 数据库名称
MYSQL_DATABASE=

# 应用写账号：用于主库写入、迁移和数据库就绪检查。
MYSQL_WRITE_USER=pyramid_writer

# 应用读账号：业务库 SELECT，并最小读取 Performance Schema digest 摘要表。
MYSQL_READ_USER=pyramid_reader

# 复制状态检查账号：只用于 SHOW REPLICA STATUS，缺失时 eventual 读会回退主库。
MYSQL_REPLICA_STATUS_USER=replica_status

# 复制通道账号：只用于从库拉取主库 binlog。
MYSQL_REPLICATION_USER=replica

MYSQL_WRITE_HOST=mysql-primary
MYSQL_READ_HOSTS=mysql-replica

MYSQL_PORT=3306
MYSQL_POOL_SIZE_WRITE=5
MYSQL_POOL_SIZE_READ=5
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=3
MYSQL_POOL_ACQUIRE_RETRY_MS=50
MYSQL_REPLICA_MAX_LAG_SECONDS=2
MYSQL_REPLICA_STATUS_CACHE_SECONDS=2
MYSQL_QUERY_WARN_MS=500

# LangGraph checkpoint 与长期记忆 Store 专用 PostgreSQL。checkpoint schema 由统一 bootstrap 初始化；
# Agent worker 负责 Store setup，Agent 持久化清理 worker 复用同一实例。
CHECKPOINT_POSTGRES_HOST=postgres-checkpoint
CHECKPOINT_POSTGRES_PORT=5432
CHECKPOINT_POSTGRES_DATABASE=causalagent_checkpoints
CHECKPOINT_POSTGRES_USER=causalagent_checkpoint
CHECKPOINT_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
CHECKPOINT_POSTGRES_POOL_MIN_SIZE=1
CHECKPOINT_POSTGRES_POOL_MAX_SIZE=5
AGENT_PERSISTENCE_CLEANUP_POLL_INTERVAL_SECONDS=1
AGENT_PERSISTENCE_CLEANUP_HEARTBEAT_INTERVAL_SECONDS=10
AGENT_PERSISTENCE_CLEANUP_LEASE_SECONDS=300

# 管理员写入：批量上限、同步删除规模阈值与事务锁等待上限。
ADMIN_BATCH_MAX_TARGETS=20
ADMIN_DELETE_MAX_RELATED_ROWS=10000
ADMIN_DB_LOCK_WAIT_TIMEOUT_SECONDS=5

# 管理员只读数据库看板：单条 SELECT 超时与连接使用率状态阈值。
DB_INSPECTION_QUERY_TIMEOUT_MS=3000
DB_DASHBOARD_CONNECTION_WARNING_PERCENT=70
DB_DASHBOARD_CONNECTION_CRITICAL_PERCENT=85

# 数据库看板共享快照采集：Web 只读取最近快照，独立 monitor 按层级周期采集。
DB_MONITOR_AUTO_REFRESH_ENABLED=true
DB_MONITOR_REALTIME_INTERVAL_SECONDS=10
DB_MONITOR_SQL_INTERVAL_SECONDS=60
DB_MONITOR_TABLE_CAPACITY_INTERVAL_SECONDS=900
DB_MONITOR_SLOW_QUERY_WARNING_DELTA=1
DB_MONITOR_INTEGRITY_ENABLED=false
DB_MONITOR_INTEGRITY_INTERVAL_SECONDS=86400

# Grafana 本地开发登录配置；管理员密码来自密钥文件。
GRAFANA_ADMIN_USER=admin
# 浏览器访问 Grafana 的地址：开发为本机映射端口的 /grafana/ 子路径。
GRAFANA_PUBLIC_URL=http://127.0.0.1:3000/grafana/

# 可选，仅本地开发使用：显式设置后，已通过 Flask 鉴权的管理员页面跳转到 Vite,可以进行热更新
ADMIN_VITE_DEV_SERVER_URL=

# 可选，仅本地开发使用：官网公开页面跳转到官网 Vite 开发服务器；普通应用与 RAG 评测台见 CHAT_VITE_DEV_SERVER_URL
WEBSITE_VITE_DEV_SERVER_URL=

# Web/后台任务并发配置
RAG_EVAL_ROOT=tmp/rag_eval
RAG_EVAL_DATASET_ROOT=tmp/rag_eval/datasets/registered
RAG_EVAL_EVALUATION_WORKERS=5
RAG_EVAL_INGESTION_CONCURRENCY_LIMIT=1
RAG_EVAL_CANDIDATE_GENERATION_CONCURRENCY_LIMIT=1
RAG_EVAL_TUNING_DATASET_GOVERNANCE_CONCURRENCY_LIMIT=1
RAG_EVAL_DATASET_GOVERNANCE_CONCURRENCY_LIMIT=1
RAG_EVAL_EVALUATION_CONCURRENCY_LIMIT=3
RAG_EVAL_RAG_QUERY_CONCURRENCY_LIMIT=2
RAG_EVAL_EVALUATION_POLL_INTERVAL_SECONDS=1
RAG_EVAL_EVALUATION_HEARTBEAT_INTERVAL_SECONDS=10
RAG_EVAL_EVALUATION_JOB_STALE_AFTER_SECONDS=120
RAG_EVAL_EVALUATION_STALE_AFTER_SECONDS=1800
WEB_WORKERS=1
WEB_THREADS=12
WEB_TIMEOUT=120
SSE_POLL_INTERVAL_SECONDS=0.05
JOB_WORKERS=2
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_STALE_AFTER_SECONDS=120
JOB_DRAINING_STALE_AFTER_SECONDS=420
JOB_DRAIN_TIMEOUT_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_CHAT_HISTORY_LIMIT=50

MAX_UPLOAD_SIZE_MB=20

# 隔离评测远程视觉默认关闭；启用时仍需逐来源显式授权。
VISION_ALLOW_REMOTE_DATA=false
VISION_BASE_URL=
VISION_MODEL=qwen-vl-plus

# LangSmith 项目名称（密钥来自密钥文件，不配置则不开启追踪）
LANGCHAIN_PROJECT=

# 联网搜索（SearXNG）
WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080

# 主应用vue热重载开发
# CHAT_VITE_DEV_SERVER_URL=http://127.0.0.1:5174
