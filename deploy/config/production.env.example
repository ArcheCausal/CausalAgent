# 服务器非密钥环境文件模板。
#
# 文档职责：列出部署包与 Compose 使用的非敏感配置，作为服务器 /etc/causalagent/config/production.env 的模板。
# 适用范围：测试环境和生产环境在服务器上创建非密钥环境文件时使用；密码、令牌和签名密钥不在本文件。
#
# 用法：复制为服务器上的 /etc/causalagent/config/production.env，按环境填写；
# 随后以该文件作为 Compose 的 --env-file 启动部署包。

# --- 部署身份 ---
COMPOSE_PROJECT_NAME=causalagent
CAUSALAGENT_SECRET_FILE=/etc/causalagent/secrets/causalagent.env

# 镜像引用由部署脚本根据发布清单写入发布目录的 images.env，无需在这里填写。
# Compose 依次读取 production.env 和 images.env；仅 environment 声明的普通参数
# 会传入容器，应用再通过 os.getenv 或配置类读取，不会直接打开这个文件。

# --- 模型与外部服务地址（不含密钥）---
BASE_URL=https://model-provider.example/v1
MODEL=REPLACE_WITH_MODEL_NAME
DEEP_AGENT_MODEL=deepseek-v4-flash
DEEP_AGENT_BASE_URL=https://model-provider.example/v1
DEEP_AGENT_CONTEXT_WINDOW_TOKENS=1000000
EMBEDDING_BASE_URL=https://embedding-provider.example/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
VISION_ALLOW_REMOTE_DATA=true
VISION_BASE_URL=https://vision-provider.example/v1
VISION_MODEL=qwen-vl-plus

# --- MySQL 连接与账号名 ---
MYSQL_HOST=mysql-primary
MYSQL_WRITE_HOST=mysql-primary
MYSQL_READ_HOSTS=mysql-replica
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_DATABASE=rag_eval_staging
MYSQL_WRITE_USER=app_write
MYSQL_READ_USER=app_read
MYSQL_REPLICA_STATUS_USER=replica_status
MYSQL_REPLICATION_USER=replica

# --- PostgreSQL checkpoint ---
CHECKPOINT_POSTGRES_HOST=postgres-checkpoint
CHECKPOINT_POSTGRES_PORT=5432
CHECKPOINT_POSTGRES_DATABASE=rag_eval_staging_checkpoint
CHECKPOINT_POSTGRES_USER=checkpoint

# --- RAG 生产存储路径（与命名卷挂载点一致）---
RAG_EVAL_ROOT=/app/tmp/rag_eval
RAG_EVAL_DATASET_ROOT=/app/tmp/rag_eval/datasets/registered
MULTIMODAL_INDEX_ROOT=/var/lib/causalagent/rag/formal/indexes
MULTIMODAL_ACTIVE_INDEX_CONFIG=/var/lib/causalagent/rag/formal/active_index.json
RAG_PRODUCTION_CONFIG_PATH=/var/lib/causalagent/rag/formal/production_rag_config.json

# --- 服务器数据目录（绝对路径，不随部署包分发）---
CAUSALAGENT_KB_SOURCE_DIR=/var/lib/causalagent/kb/source
CAUSALAGENT_KB_DB_DIR=/var/lib/causalagent/kb/db
CAUSALAGENT_KB_ASSETS_DIR=/var/lib/causalagent/kb/assets
CAUSALAGENT_GRAPH_OUTPUT_DIR=/var/lib/causalagent/reports/graphs

# --- 网关与观测 ---
STAGING_GATEWAY_PORT=8088
GRAFANA_ADMIN_USER=admin
GRAFANA_PUBLIC_URL=/grafana/

# --- 运行参数 ---
WEB_WORKERS=1
WEB_THREADS=12
WEB_TIMEOUT=120
JOB_WORKERS=2
RAG_EVAL_EVALUATION_WORKERS=5
