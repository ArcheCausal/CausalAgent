# 文档职责：列出控制服务独立数据库密钥文件所需键。
# 适用范围：仓库外的 /etc/causalagent/secrets/sandbox-controller.env。
# 值分别对应 MYSQL_USER / MYSQL_WRITE_USER / MYSQL_READ_USER；不放模型或上游密钥。
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
MYSQL_WRITE_PASSWORD=REPLACE_WITH_DATABASE_WRITE_PASSWORD
MYSQL_READ_PASSWORD=REPLACE_WITH_DATABASE_READ_PASSWORD
