# 服务器唯一密钥文件模板。
#
# 文档职责：列出部署必须提供的全部密钥键，以及键名的唯一权威定义。
# 适用范围：测试环境和生产环境在服务器上创建 /etc/causalagent/secrets/causalagent.env 时使用。
#
# 用法：复制为服务器上的 /etc/causalagent/secrets/causalagent.env，填写真实随机值，
# 并设置为 root:3000、权限 0640。该文件不进入 Git、不进入部署包、不进入镜像。
# 允许出现的键与 config/secret_file.py 的 SECRET_KEYS 完全一致，未知键会导致启动失败。

MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE
MYSQL_WRITE_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE
MYSQL_READ_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE
MYSQL_REPLICA_STATUS_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE
MYSQL_REPLICATION_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE

CHECKPOINT_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
API_KEY=REPLACE_WITH_MODEL_API_KEY
DEEP_AGENT_API_KEY=REPLACE_WITH_DEEP_AGENT_API_KEY
VISION_API_KEY=REPLACE_WITH_VISION_API_KEY
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY

SEARXNG_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD

CAUSAL_MCP_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
CAUSAL_MCP_SIGNING_KEY_CURRENT=REPLACE_WITH_RANDOM_SIGNING_KEY
# 可选键：LANGCHAIN_API_KEY, CAUSAL_MCP_SIGNING_KEY_PREVIOUS（需要时添加非空值行）。
